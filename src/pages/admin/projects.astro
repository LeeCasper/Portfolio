---
import AdminLayout from "@/layouts/AdminLayout.astro";

export const prerender = false;
---

<AdminLayout title="项目管理 - 后台" heading="项目管理" description="管理首页展示的项目内容">
  <div class="admin-card">
    <h2>项目列表</h2>
    <div id="projects-list"></div>
  </div>

  <div class="admin-card">
    <header>
      <h2>新增项目</h2>
      <p>点击列表中的「编辑」可载入已有项目。</p>
    </header>
    <form id="project-form" class="admin-form">
      <input name="id" type="hidden" />
      <div class="form-grid">
        <label>
          标题
          <input name="title" type="text" required />
        </label>
        <label>
          链接
          <input name="link" type="text" placeholder="https://example.com" required />
        </label>
        <label class="col-span-2">
          描述
          <textarea name="description" rows="3" placeholder="项目简介…"></textarea>
        </label>
        <label>
          封面
          <input type="hidden" name="coverImagePath" />
          <input
            type="file"
            accept="image/*"
            data-upload-target="coverImagePath"
            data-upload-category="projects-cover"
            data-upload-status="#project-cover-status"
          />
          <p id="project-cover-status" class="upload-status">尚未上传</p>
        </label>
        <label>
          视频（可选）
          <input type="hidden" name="videoPath" />
          <input
            type="file"
            accept="video/*"
            data-upload-target="videoPath"
            data-upload-category="projects-video"
            data-upload-status="#project-video-status"
          />
          <p id="project-video-status" class="upload-status">尚未上传</p>
        </label>
        <label>
          标签（逗号分隔）
          <input name="tags" type="text" placeholder="React, TypeScript" />
        </label>
        <label>
          排序
          <input name="sortOrder" type="number" value="0" />
        </label>
        <label class="checkbox-label">
          <input name="featured" type="checkbox" />
          精选项目
        </label>
        <label class="checkbox-label">
          <input name="published" type="checkbox" checked />
          对外展示
        </label>
      </div>
      <div class="admin-actions">
        <button type="submit" class="admin-button">保存项目</button>
        <button type="button" data-reset-project class="admin-secondary">重置表单</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import initAdminDashboard from "@/scripts/admin-dashboard";
  initAdminDashboard();
</script>

---
import PageLayout from "@/layouts/PageLayout.astro";
import ShowcaseDetail from "@/components/detail/ShowcaseDetail.astro";
import { apiClient, type Project } from "@/lib/apiClient";

export const prerender = false;

const id = Number(Astro.params.id);

let projects: Project[] = [];
try {
  projects = await apiClient.fetchProjects();
} catch {
  projects = [];
}

const project = projects.find((item) => item.id === id);

if (!project) {
  return new Response(
    "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><title>未找到该项目</title><body style=\"font-family:system-ui;padding:48px;text-align:center\"><h1>未找到该项目</h1><p><a href=\"/\">返回首页</a></p></body></html>",
    { status: 404, headers: { "Content-Type": "text/html; charset=utf-8" } }
  );
}

const description = project.description?.trim() || `${project.title} · 项目详情`;
---

<PageLayout title={`${project.title} · 项目`} description={description}>
  <ShowcaseDetail
    item={{
      id: project.id,
      title: project.title,
      description: project.description,
      url: project.link,
      imageUrl: project.coverImageUrl,
      videoUrl: project.videoUrl,
      tags: project.tags,
      features: project.features,
      createdAt: project.createdAt,
      updatedAt: project.updatedAt
    }}
    backHref="/"
    backLabel="项目"
    defaultCategory="项目"
  />
</PageLayout>

---
import { Eye, ExternalLink, Sparkles, Tag } from "@lucide/astro";
import type { ShowcaseItem } from "@/types/showcase";
import { stripInlineMarkdown } from "@/lib/inline-markdown";

interface Props {
  item: ShowcaseItem;
  index?: number;
  /** 「查看详情」跳转的详情页地址 */
  detailHref: string;
}

const { item, index = 0, detailHref } = Astro.props;

const fallbackImage = "/assets/home/gradientshub.jpg";
const image = item.imageUrl?.trim() || fallbackImage;

const normalizedUrl = item.url.match(/^(https?:\/\/|\/|#)/i) ? item.url : `https://${item.url}`;

const created = item.createdAt ? new Date(item.createdAt) : null;
const dateLabel =
  created && !Number.isNaN(created.getTime()) ? created.toISOString().slice(0, 10) : "";

const description = stripInlineMarkdown(item.description?.trim() || "");

// 左侧信息块上方显示一个数量：优先项目亮点数，其次技术标签数
const featureCount = (item.features ?? []).filter((feature) => feature?.trim()).length;
const tagCount = (item.tags ?? []).filter((tag) => tag?.trim()).length;
const statCount = featureCount || tagCount;
const StatIcon = featureCount > 0 ? Sparkles : Tag;
---

<article
  class="group flex h-full flex-col rounded-2xl border border-neutral-200/80 bg-white p-3 shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition-all duration-300 hover:-translate-y-0.5 hover:border-neutral-300/80 hover:shadow-[0_20px_45px_-22px_rgba(16,24,40,0.3)] sm:p-4 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700"
  data-aos="fade-up"
  data-aos-duration="500"
  data-aos-delay={index * 80}
  data-aos-once="true"
>
  <!-- 浏览器窗口的小圆点 -->
  <div class="flex items-center gap-1.5 px-1 pb-3">
    <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
  </div>

  <!-- 封面 -->
  <a
    href={detailHref}
    class="relative block aspect-[16/9] overflow-hidden rounded-xl bg-neutral-100 ring-1 ring-black/5 dark:bg-neutral-800 dark:ring-white/10"
  >
    {item.videoUrl ? (
      <video
        src={item.videoUrl}
        poster={image}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    ) : (
      <img
        src={image}
        alt={item.title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    )}

    <span
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >
    </span>
  </a>

  <!-- 信息区：左侧统计与日期块，右侧标题与简介 -->
  <div class="flex flex-1 gap-4 px-1 pt-5 pb-4">
    <div class="w-[88px] shrink-0 self-start overflow-hidden rounded-xl border border-neutral-200/90 bg-white dark:border-neutral-700 dark:bg-neutral-900">
      {statCount > 0 && (
        <div class="flex items-center justify-center gap-1 border-b border-neutral-200/80 py-2 dark:border-neutral-700/80">
          <StatIcon size={13} class="text-primary dark:text-primary-light" />
          <span class="text-sm font-semibold tabular-nums text-neutral-800 dark:text-neutral-100">{statCount}</span>
          <span class="text-[10px] text-neutral-400">项</span>
        </div>
      )}
      {dateLabel && (
        <div class="bg-primary py-1.5 text-center text-[11px] font-medium tabular-nums text-white">
          {dateLabel}
        </div>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <h3
        class="truncate text-lg font-semibold text-neutral-900 transition-colors duration-300 group-hover:text-primary sm:text-[22px] dark:text-white dark:group-hover:text-primary-light"
      >
        <a href={detailHref}>{item.title}</a>
      </h3>
      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
        {description || "暂无描述，点击查看详情。"}
      </p>
    </div>
  </div>

  <!-- 操作按钮 -->
  <div class="mt-auto grid grid-cols-2 gap-2">
    <a
      href={normalizedUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-3 py-2.5 text-sm font-medium text-neutral-700 transition-colors duration-200 hover:border-primary/40 hover:text-primary dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-primary/50 dark:hover:text-primary-light"
    >
      预览站点 <ExternalLink size={14} />
    </a>
    <a
      href={detailHref}
      class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-primary px-3 py-2.5 text-sm font-medium text-white transition-colors duration-200 hover:bg-primary-strong dark:bg-primary-dark dark:hover:bg-primary"
    >
      查看详情 <Eye size={14} />
    </a>
  </div>
</article>

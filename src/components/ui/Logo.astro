---
interface Props {
  /** 站点 Logo 地址，未设置时使用本地默认图 */
  src?: string | null;
}

const { src } = Astro.props;
const logoSrc = src?.trim() || "/assets/logo.png";
---

<a
  href="/"
  class="h-10 text-base group relative z-30 flex items-center aspect-square"
>
  <img src={logoSrc} alt="Logo" class="w-10 h-10 rounded-full object-cover" />
</a>

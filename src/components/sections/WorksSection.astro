---
import WorkShowcaseCard from "@/components/cards/WorkShowcaseCard.astro";
import { apiClient, type Work } from "@/lib/apiClient";

interface Props {
  limit?: number;
}

const { limit } = Astro.props as Props;

let works: Work[] = [];
let worksError: string | null = null;

try {
  works = await apiClient.fetchWorks();
} catch (error) {
  worksError = error instanceof Error ? error.message : "无法加载作品数据";
}

const visibleWorks = typeof limit === "number" ? works.slice(0, limit) : works;
const fallbackImage = "/assets/home/gradientshub.jpg";
---

<section class="py-8 md:py-10">
  <div class="space-y-8 md:space-y-10">
    {worksError && (
      <div class="text-center text-sm rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-600 dark:border-red-900/40 dark:bg-red-900/20">
        {worksError}
      </div>
    )}

    {!worksError && visibleWorks.length === 0 && (
      <div class="text-center text-neutral-500 dark:text-neutral-400 rounded-xl border border-dashed border-neutral-200 px-4 py-8 dark:border-neutral-700">
        暂无作品，请先在后台添加内容。
      </div>
    )}

    {!worksError && visibleWorks.length > 0 && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-7">
        {visibleWorks.map((work, index) => (
          <WorkShowcaseCard
            work={work}
            image={work.imageUrl || fallbackImage}
            index={index}
          />
        ))}
      </div>
    )}
  </div>
</section>

<script>
  // 详情弹窗：按钮打开对应的原生 dialog，点遮罩 / 关闭按钮 / Esc 均可关闭
  const openButtons = document.querySelectorAll<HTMLElement>('[data-work-open]');

  openButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.workOpen;
      if (!target) return;

      const dialog = document.getElementById(target);
      if (dialog instanceof HTMLDialogElement && !dialog.open) {
        dialog.showModal();
      }
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.work-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      // 点击 dialog 元素本身（即遮罩区域）时关闭
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.querySelectorAll('[data-work-close]').forEach((closeButton) => {
      closeButton.addEventListener('click', () => dialog.close());
    });
  });
</script>

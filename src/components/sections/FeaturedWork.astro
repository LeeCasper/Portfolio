---
import ShowcaseCard from "@/components/cards/ShowcaseCard.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import { apiClient, type Work } from "@/lib/apiClient";

interface Props {
  title?: string;
  description?: string;
  showAll?: boolean;
  limit?: number;
}

const {
  title = "精选作品",
  description = "这些作品覆盖课堂实验、实验室协作与个人兴趣，展示我如何把 Java 与界面实现结合。",
  showAll = false,
  limit
} = Astro.props as Props;

// 首页与「我的作品」页共用同一份数据（后台「作品管理」），编辑一次两处同步
let works: Work[] = [];
let worksError: string | null = null;

try {
  works = await apiClient.fetchWorks();
} catch (error) {
  worksError = error instanceof Error ? error.message : "无法加载作品数据";
}

const totalWorks = works.length;
let visibleWorks = works;

if (typeof limit === "number") {
  visibleWorks = works.slice(0, limit);
} else if (!showAll) {
  visibleWorks = works.slice(0, 6);
}

const shouldShowViewAll = typeof limit === "number"
  ? limit < totalWorks
  : !showAll && totalWorks > 6;
---

<section class="py-16 md:py-16 md:pb-12">
  <div class="site-container space-y-8 md:space-y-8">
    <SectionHeader title={title} description={description} />

    {worksError && (
      <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600 dark:border-red-900/40 dark:bg-red-900/20">
        {worksError}
      </div>
    )}

    {!worksError && totalWorks === 0 && (
      <div class="rounded-xl border border-dashed border-neutral-200 px-4 py-6 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-300">
        暂无作品，请在后台「作品管理」添加。
      </div>
    )}

    {!worksError && totalWorks > 0 && (
      <>
        <div
          class="grid gap-6 md:gap-7 md:grid-cols-2"
          data-aos-delay="150"
          data-aos="fade-up-sm"
          data-aos-duration="1000"
          data-aos-once="true"
        >
          {visibleWorks.map((work, index) => (
            <ShowcaseCard
              item={{
                id: work.id,
                title: work.name,
                description: work.description,
                url: work.url,
                imageUrl: work.imageUrl,
                videoUrl: work.videoUrl,
                tags: work.tags,
                features: work.features,
                createdAt: work.createdAt,
                updatedAt: work.updatedAt
              }}
              detailHref={`/works/${work.id}`}
              index={index}
              defaultCategory="作品"
            />
          ))}
        </div>

        {shouldShowViewAll && (
          <div class="flex items-center justify-center pt-4">
            <Button url="/works" className="w-full max-w-60">
              查看全部作品
            </Button>
          </div>
        )}
      </>
    )}
  </div>
</section>

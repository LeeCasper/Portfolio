---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
import { siteConfig } from "@/config/site.js";
import socialJson from "@/collections/social.json";
import type { SocialItem } from "@/types/collections";

const socialItems = socialJson as SocialItem[];
import {
  BadgeCheck,
  BookOpen,
  Figma,
  Github,
  Link as LinkIcon,
  Mail,
  MessageCircle,
  Palette,
  PenTool,
  Phone,
  Rss,
  ShieldCheck
} from "@lucide/astro";

// 个人社交入口统一来自 collections/social.json；这里只做 name → 图标 的展示映射。
const ICON_MAP: Record<string, unknown> = {
  Github,
  邮箱: Mail,
  电话: Phone,
  微信: MessageCircle,
  博客: BookOpen,
  设计灵感: Palette,
  "Figma 文件": Figma,
  界面草稿: PenTool
};

interface Props {
  /** 由 Layout 统一获取后传入，用于展示后台设置的站点 Logo */
  profile?: import("@/lib/apiClient").Profile | null;
}

const { profile = null } = Astro.props;

// 备案信息由后台「个人信息 → 备案信息」维护；未填写时不展示这一行
const icpNumber = profile?.icpNumber?.trim() || "";
const icpUrl = profile?.icpUrl?.trim() || "https://beian.miit.gov.cn/";
const icpIconUrl = profile?.icpIconUrl?.trim() || "";
const policeNumber = profile?.policeNumber?.trim() || "";
const policeUrl = profile?.policeUrl?.trim() || "https://beian.mps.gov.cn/";
const policeIconUrl = profile?.policeIconUrl?.trim() || "";
const hasFiling = Boolean(icpNumber || policeNumber);

const footerSocials = socialItems
  .filter((item) => item.isShow !== false)
  .map((item) => {
    const Icon = (ICON_MAP[item.name] ?? LinkIcon) as typeof Github;
    return { name: item.name, url: item.url, Icon };
  });
---

<section
  class="text-gray-700  border-t mt-20 md:mt-48  border-dashed border-primary/15 dark:border-primary-dark/15 border-[.75px]"
>
  <div
    class="container flex flex-col items-center py-8 mx-auto px-7 max-w-7xl sm:flex-row"
  >
    <Logo src={profile?.logoUrl} />
    <p
      class="mt-4 text-sm text-neutral-700 dark:text-neutral-100 sm:ml-4 sm:pl-4 sm:border-l sm:border-neutral-300 dark:sm:border-neutral-700 sm:mt-0"
    >
      © {new Date().getFullYear()}

       <a href={siteConfig.url || " "} target="_blank">{siteConfig.author || " "}</a>
    </p>
    <span
      class="inline-flex justify-center mt-4 space-x-5 sm:ml-auto sm:mt-0 sm:justify-start overflow-hidden"
    >
      {footerSocials.map(({ name, url, Icon }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social-icon-link text-neutral-500 dark:text-neutral-300 "
          title={name}
        >
          <span class="sr-only">{name}</span>
          <div class="footer-social-icon text-neutral-500" >
            <Icon size={20} />
          </div>
        </a>
      ))}
      <a
        href="/rss.xml"
        target="_blank"
        class="footer-social-icon-link text-neutral-500 dark:text-neutral-300"
        title="RSS"
      >
        <span class="sr-only">RSS</span>
        <div class="footer-social-icon text-neutral-500">
          <Rss size={20} />
        </div>
      </a>
    </span>
  </div>

  {hasFiling && (
    <div class="container mx-auto max-w-7xl px-7 pb-8">
      <div
        class="flex flex-col items-center gap-3 border-t border-dashed border-primary/15 pt-6 text-xs text-neutral-500 dark:border-neutral-800 dark:text-neutral-400 sm:flex-row sm:justify-center sm:gap-8"
      >
        {icpNumber && (
          <a
            href={icpUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 transition-colors duration-200 hover:text-primary dark:hover:text-primary-light"
          >
            {icpIconUrl ? (
              <img src={icpIconUrl} alt="ICP 备案图标" class="h-4 w-4 shrink-0 object-contain" loading="lazy" />
            ) : (
              <BadgeCheck size={15} class="shrink-0 text-primary dark:text-primary-light" aria-hidden="true" />
            )}
            <span>{icpNumber}</span>
          </a>
        )}

        {policeNumber && (
          <a
            href={policeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 transition-colors duration-200 hover:text-primary dark:hover:text-primary-light"
          >
            {policeIconUrl ? (
              <img src={policeIconUrl} alt="公安备案图标" class="h-4 w-4 shrink-0 object-contain" loading="lazy" />
            ) : (
              <ShieldCheck size={15} class="shrink-0 text-primary dark:text-primary-light" aria-hidden="true" />
            )}
            <span>{policeNumber}</span>
          </a>
        )}
      </div>
    </div>
  )}
</section>

<!-- 返回顶部按钮 -->
<ToTop />

<style is:global>
  .footer-social-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease-in-out;
    overflow: hidden;
  }

  .footer-social-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    transition: all 0.3s ease-in-out;
  }
  .footer-social-icon-link:hover .footer-social-icon svg {
    width: auto;
    height: 24px;
    fill: currentColor;
  }
</style>

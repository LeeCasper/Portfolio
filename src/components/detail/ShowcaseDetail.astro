---
import { ArrowLeft, Boxes, Code, Database, ExternalLink, Gauge, Layers, Rocket, ShieldCheck, Sparkles, Zap } from "@lucide/astro";
import type { ShowcaseItem } from "@/types/showcase";
import { renderInlineMarkdown } from "@/lib/inline-markdown";
import { getTechIcon } from "@/config/tech-stack";

interface Props {
  item: ShowcaseItem;
  /** 返回列表的地址与名称（作品 / 项目） */
  backHref: string;
  backLabel: string;
}

const { item, backHref, backLabel } = Astro.props;

const fallbackImage = "/assets/home/gradientshub.jpg";
const image = item.imageUrl?.trim() || fallbackImage;

const normalizedUrl = item.url.match(/^(https?:\/\/|\/|#)/i) ? item.url : `https://${item.url}`;
const tags = (item.tags ?? []).map((tag) => tag.trim()).filter(Boolean);
const features = (item.features ?? []).map((feature) => feature.trim()).filter(Boolean);

function formatDate(value?: string | null) {
  if (!value) return "";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? "" : date.toISOString().slice(0, 10);
}

const createdAt = formatDate(item.createdAt);
const updatedAt = formatDate(item.updatedAt);

// 详情页统一的内容宽度：比常规容器略宽，左右留白一致
const wrapClass =
  "mx-auto w-full max-w-[1200px] px-4 lg:w-[calc(100%-96px)] lg:max-w-[1320px] lg:px-0";

// 亮点卡片按顺序轮换图标，避免每张卡片都一样
const FEATURE_ICONS = [Sparkles, Layers, ShieldCheck, Gauge, Zap, Rocket, Database, Boxes];

/**
 * 后台亮点常见写法：`1. **标题**：说明` 或 `标题：说明`。
 * 拆出标题与说明，卡片就能做出「图标 + 标题 + 描述」的层次；没有标题时整段作为说明。
 */
function parseFeature(raw: string) {
  const text = raw.trim().replace(/^\s*\d+\s*[.、)）]\s*/, "");
  const bold = text.match(/^\*\*(.+?)\*\*\s*[：:]\s*([\s\S]+)$/);
  if (bold) return { title: bold[1].trim(), desc: bold[2].trim() };

  const plain = text.match(/^([^：:。]{2,18})[：:]\s*([\s\S]+)$/);
  if (plain) return { title: plain[1].trim(), desc: plain[2].trim() };

  return { title: "", desc: text };
}

const paragraphs = (item.description ?? "")
  .split(/\r?\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<article class="relative">
  <!-- 顶部淡淡的品牌色氛围 -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-primary/[0.07] to-transparent dark:from-primary/[0.12]"></div>

  <!-- 头部两栏：左侧信息，右侧浏览器预览 -->
  <section class="relative py-10 md:py-14">
    <!-- 宽度比常规容器略宽，左右留白保持一致（右侧预览图不会被挤小） -->
    <div class={wrapClass}>
      <a
        href={backHref}
        class="inline-flex items-center gap-1.5 text-sm text-neutral-500 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light"
      >
        <ArrowLeft size={15} /> 返回{backLabel}列表
      </a>

      <div class="mt-6 grid items-start gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-12">
        <div class="flex flex-col">
          <h1 class="text-4xl font-bold leading-tight tracking-tight text-neutral-900! sm:text-5xl dark:text-white!">
            {item.title}
          </h1>
          <span class="mt-4 block h-1 w-14 rounded-full bg-gradient-to-r from-primary to-primary-light"></span>

          {paragraphs.length > 0 && (
            <div class="mt-6 space-y-3 text-base leading-relaxed text-neutral-600 sm:text-lg dark:text-neutral-300">
              {paragraphs.map((paragraph) => <p set:html={renderInlineMarkdown(paragraph)} />)}
            </div>
          )}

          <!-- 信息卡 -->
          <div
            class="mt-8 rounded-2xl border border-neutral-200/80 bg-white/80 p-5 shadow-[0_1px_2px_rgba(16,24,40,0.04)] backdrop-blur-sm dark:border-neutral-800 dark:bg-neutral-900/60"
          >
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-neutral-500 dark:text-neutral-400">
              {createdAt && <span>发布于 <span class="tabular-nums">{createdAt}</span></span>}
              {updatedAt && (
                <>
                  <span class="text-neutral-300 dark:text-neutral-600">·</span>
                  <span>最近更新 <span class="tabular-nums">{updatedAt}</span></span>
                </>
              )}
            </div>

            {tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="rounded-full border border-primary/15 bg-primary/5 px-3 py-1 text-xs font-medium text-primary dark:border-primary/25 dark:bg-primary/10 dark:text-primary-light">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- 操作按钮 -->
          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_auto]">
            <a
              href={normalizedUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-medium text-white transition-colors duration-200 hover:bg-primary-strong dark:bg-primary-dark dark:hover:bg-primary"
            >
              预览站点 <ExternalLink size={16} />
            </a>
            <a
              href={backHref}
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-neutral-200 bg-white px-5 py-3 text-sm font-medium text-neutral-700 transition-colors duration-200 hover:border-primary/40 hover:text-primary dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-primary/50 dark:hover:text-primary-light"
            >
              返回列表
            </a>
          </div>
        </div>

        <!-- 右侧浏览器窗口预览 -->
        <div class="flex lg:justify-end">
          <div
            class="w-full overflow-hidden rounded-2xl border border-neutral-200/80 bg-white p-3 shadow-[0_30px_60px_-32px_rgba(16,24,40,0.4)] lg:max-w-[860px] dark:border-neutral-800 dark:bg-neutral-900"
          >
            <div class="flex items-center gap-1.5 px-1 pb-3">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
            </div>

            <div class="aspect-[16/10] overflow-hidden rounded-xl bg-neutral-100 ring-1 ring-black/5 dark:bg-neutral-800 dark:ring-white/10">
              {item.videoUrl ? (
                <video
                  src={item.videoUrl}
                  poster={image}
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  class="h-full w-full object-cover"
                />
              ) : (
                <img src={image} alt={item.title} class="h-full w-full object-cover" />
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 项目亮点 -->
  {features.length > 0 && (
    <section class="relative border-t border-dashed border-neutral-200 py-14 dark:border-neutral-800">
      <div class={wrapClass}>
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900! sm:text-3xl dark:text-white!">
          项目亮点 <span class="ml-2 text-lg font-normal text-neutral-400 dark:text-neutral-500">Features</span>
        </h2>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {features.map((feature, index) => {
            const { title, desc } = parseFeature(feature);
            const Icon = FEATURE_ICONS[index % FEATURE_ICONS.length];

            return (
              <div class="group flex flex-col items-center rounded-2xl border border-neutral-200/80 bg-white px-6 py-9 text-center shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/25 hover:shadow-[0_22px_45px_-28px_rgba(16,24,40,0.4)] dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-primary/40">
                <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/8 text-primary transition-transform duration-300 group-hover:scale-110 dark:bg-primary/15 dark:text-primary-light">
                  <Icon size={28} stroke-width={1.6} />
                </span>

                {title && (
                  <h3 class="mt-5 text-lg font-semibold text-neutral-900! dark:text-white!">{title}</h3>
                )}

                <p
                  class={title
                    ? "mt-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400"
                    : "mt-5 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300"}
                  set:html={renderInlineMarkdown(desc)}
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- 技术栈 -->
  {tags.length >= 2 && (
    <section class="border-t border-dashed border-neutral-200 py-14 dark:border-neutral-800">
      <div class={wrapClass}>
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900! sm:text-3xl dark:text-white!">
          技术栈 <span class="ml-2 text-lg font-normal text-neutral-400 dark:text-neutral-500">Tech Stack</span>
        </h2>

        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {tags.map((tag) => (
            <div class="group flex items-center gap-4 rounded-2xl border border-neutral-200/80 bg-white px-5 py-5 shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/25 hover:shadow-[0_18px_38px_-26px_rgba(16,24,40,0.4)] dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-primary/40">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-neutral-100/80 ring-1 ring-neutral-200/60 transition-transform duration-300 group-hover:scale-110 dark:bg-neutral-800 dark:ring-neutral-700/60">
                {getTechIcon(tag) ? (
                  <img src={getTechIcon(tag)!} alt="" class="h-7 w-7 object-contain" loading="lazy" />
                ) : (
                  <Code size={22} stroke-width={1.8} class="text-primary dark:text-primary-light" />
                )}
              </span>
              <span class="truncate text-base font-semibold text-neutral-800 dark:text-neutral-100">{tag}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</article>

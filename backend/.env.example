# Backend Configuration
#
# 注意：Spring Boot 不会自动读取 .env 文件。这里的变量需要你显式 export，
# 或者用启动参数传入（如 java -jar app.jar --server.port=8081），
# 也可以直接修改 backend/src/main/resources/application.yml。

PORT=8081
CONTENT_STORAGE_ROOT=storage/media
CONTENT_MEDIA_BASE_URL=http://localhost:8081/api/files
CONTENT_DATA_PATH=storage/data

# 必填，没有默认值：未设置时后端会拒绝启动。
# 请换成一个足够长的随机字符串。注意它会被前端后台页面以请求头的形式发送，
# 因此生产环境务必启用 HTTPS。
CONTENT_ADMIN_TOKEN=请替换为随机字符串

PUBLIC_APP_ORIGIN=http://localhost:5200
